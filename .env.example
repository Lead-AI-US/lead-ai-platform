# Lead.AI Platform — environment variables
# Copy to .env.local for local development. Never commit real .env files.

APP_NAME="Lead.AI Platform"
APP_ENV="development"
APP_BASE_URL="http://localhost:5173"

# ── Firebase client (public — safe to ship to the browser) ──────────────
# Access control is enforced by Firestore Security Rules, not by hiding
# these values. Get them from Firebase Console > Project Settings > General.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (SERVER ONLY — never prefix with VITE_) ──────────────
# From a service account JSON key (Firebase Console > Project Settings >
# Service Accounts > Generate new private key). Keep FIREBASE_PRIVATE_KEY's
# newlines as literal "\n" when pasting into a single-line env var UI.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── OpenAI (SERVER ONLY) ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_CHAT="gpt-4.1-mini"
LEAD_AI_CHAT_PROMPT_VERSION="2026-08-v1"

# ── Local emulator (optional — see docs/LOCAL_DEVELOPMENT.md) ──────────
# Set to run against the Firebase emulator suite instead of a real project.
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
